name: secret-demo

on:
  workflow_dispatch:

jobs:
  secret-demo:
    name: Print secret length
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Print secret length
        env:
          MIGRATION_DEMO_SECRET: ${{ secrets.MIGRATION_DEMO_SECRET }}
        run: |
          if [ -z "${MIGRATION_DEMO_SECRET:-}" ]; then
            echo "::error::MIGRATION_DEMO_SECRET is not configured"
            exit 1
          fi

          echo "MIGRATION_DEMO_SECRET was injected successfully."
          echo "Secret length: ${#MIGRATION_DEMO_SECRET}"
